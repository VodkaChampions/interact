<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= club.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <canvas id="bg-canvas"></canvas>

  <!-- Title Screen Lockup -->
  <div id="lockup">
    <div class="txt" id="lockup-text">
      <h1 class="t1">Interact</h1>
      <p class="t2">Club of BDU STEM Center</p>
      <p class="t3"><%= club.location %></p>
    </div>
    <!-- 3D WebGL Rotary Wheel renders directly over this layout anchor -->
    <div class="mark" id="wheel-anchor"></div>
  </div>

  <!-- Main Menu Placeholder (Appears Post-Tunnel) -->
  <div id="main-content" aria-label="Main Menu Placeholder" class="main-menu-container">
    <div class="menu-modal placeholder-modal">
      <div class="menu-badge placeholder-badge">
        <span class="badge-dot warning-dot"></span>
        <span>🚧 WORK IN PROGRESS • PLACEHOLDER</span>
      </div>
      <h2 class="menu-title">Main Menu <span class="title-badge">[Placeholder]</span></h2>
      <p class="menu-subtitle">You have reached the destination of the timeline tunnel. This interactive space is reserved for the full Main Menu currently in development.</p>

      <div class="placeholder-blueprint-banner">
        <span class="bp-icon">📐</span>
        <div class="bp-text">
          <strong>Architecture Draft:</strong> 8 interactive section modules will connect here to showcase club stories, STEM projects, and youth leadership initiatives.
        </div>
      </div>

      <div class="menu-grid">
        <div class="menu-card is-placeholder" data-section="0">
          <div class="mc-icon">🏠</div>
          <div class="mc-info">
            <div class="mc-name">Home <span class="ph-tag">Placeholder</span></div>
            <div class="mc-desc">Overview &amp; club highlights</div>
          </div>
        </div>

        <div class="menu-card is-placeholder" data-section="1">
          <div class="mc-icon">📖</div>
          <div class="mc-info">
            <div class="mc-name">About Us <span class="ph-tag">Placeholder</span></div>
            <div class="mc-desc">Mission, vision &amp; values</div>
          </div>
        </div>

        <div class="menu-card is-placeholder" data-section="2">
          <div class="mc-icon">🚀</div>
          <div class="mc-info">
            <div class="mc-name">Our Projects <span class="ph-tag">Placeholder</span></div>
            <div class="mc-desc">STEM innovations &amp; community service</div>
          </div>
        </div>

        <div class="menu-card is-placeholder" data-section="3">
          <div class="mc-icon">🎉</div>
          <div class="mc-info">
            <div class="mc-name">Events &amp; Activities <span class="ph-tag">Placeholder</span></div>
            <div class="mc-desc">Saturday assemblies &amp; workshops</div>
          </div>
        </div>

        <div class="menu-card is-placeholder" data-section="4">
          <div class="mc-icon">👥</div>
          <div class="mc-info">
            <div class="mc-name">Our Team <span class="ph-tag">Placeholder</span></div>
            <div class="mc-desc">Student executive board</div>
          </div>
        </div>

        <div class="menu-card is-placeholder" data-section="5">
          <div class="mc-icon">🖼️</div>
          <div class="mc-info">
            <div class="mc-name">Gallery <span class="ph-tag">Placeholder</span></div>
            <div class="mc-desc">Photo archives &amp; moments</div>
          </div>
        </div>

        <div class="menu-card is-placeholder" data-section="6">
          <div class="mc-icon">✋</div>
          <div class="mc-info">
            <div class="mc-name">Join Us <span class="ph-tag">Placeholder</span></div>
            <div class="mc-desc">Membership signup &amp; onboarding</div>
          </div>
        </div>

        <div class="menu-card is-placeholder" data-section="7">
          <div class="mc-icon">✉️</div>
          <div class="mc-info">
            <div class="mc-name">Contact Us <span class="ph-tag">Placeholder</span></div>
            <div class="mc-desc">STEM Center Hall B &amp; Telegram</div>
          </div>
        </div>
      </div>

      <div class="menu-footer">
        <span class="menu-return-hint">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 15-6-6-6 6"/>
          </svg>
          Scroll UP to return and explore the interactive timeline tunnel
        </span>
      </div>
    </div>
  </div>

  <!-- 3D Spatial Beacon Stations Anchored to In-Tunnel Swarm Particles -->
  <div id="beacon-overlay" aria-label="3D Interactive Stations">
    <% if (typeof tunnelItems !== 'undefined' && tunnelItems.length > 0) { %>
      <% tunnelItems.forEach(function(item) { %>
        <div class="beacon-node <%= item.side || 'face-right' %>" id="<%= item.id %>" data-pidx="<%= item.pIdx %>">
          <% if (item.side === 'face-left') { %>
            <!-- Right wall particle pointing inward to the left -->
            <svg class="beacon-stem stem-left" width="55" height="25" viewBox="0 0 55 25">
              <polyline points="55,20 35,6 0,6" fill="none" stroke="rgba(29, 133, 215, 0.55)" stroke-width="1.4" stroke-dasharray="2 2" />
              <circle cx="0" cy="6" r="2.5" fill="#1d85d7" />
            </svg>
          <% } else if (item.side === 'face-down') { %>
            <!-- Top wall particle pointing inward downward -->
            <svg class="beacon-stem stem-down" width="25" height="45" viewBox="0 0 25 45">
              <polyline points="12,0 12,25 12,45" fill="none" stroke="rgba(29, 133, 215, 0.55)" stroke-width="1.4" stroke-dasharray="2 2" />
              <circle cx="12" cy="45" r="2.5" fill="#1d85d7" />
            </svg>
          <% } else if (item.side === 'face-up') { %>
            <!-- Bottom wall particle pointing inward upward -->
            <svg class="beacon-stem stem-up" width="25" height="45" viewBox="0 0 25 45">
              <polyline points="12,45 12,20 12,0" fill="none" stroke="rgba(29, 133, 215, 0.55)" stroke-width="1.4" stroke-dasharray="2 2" />
              <circle cx="12" cy="0" r="2.5" fill="#1d85d7" />
            </svg>
          <% } else { %>
            <!-- Left wall particle pointing inward to the right (default) -->
            <svg class="beacon-stem stem-right" width="55" height="25" viewBox="0 0 55 25">
              <polyline points="0,20 20,6 55,6" fill="none" stroke="rgba(29, 133, 215, 0.55)" stroke-width="1.4" stroke-dasharray="2 2" />
              <circle cx="55" cy="6" r="2.5" fill="#1d85d7" />
            </svg>
          <% } %>

          <div class="beacon-card">
            <div class="card-header">
              <span class="card-tag-badge"><%= item.badge || '✨ Story' %></span>
              <span class="card-tag-title"><%= item.title %></span>
              <button class="card-toggle-btn" aria-label="Toggle details">+</button>
            </div>
            <div class="card-drawer">
              <div class="card-body">
                <% if (item.kicker) { %>
                  <span class="card-kicker"><%= item.kicker %></span>
                <% } %>
                <h3 class="card-heading"><%= item.title %></h3>
                <% if (item.sub) { %>
                  <p class="card-sub"><%= item.sub %></p>
                <% } %>
                <% if (item.desc) { %>
                  <p class="card-desc"><%= item.desc %></p>
                <% } %>

                <% if (item.pills && item.pills.length > 0) { %>
                  <div class="card-pill-list">
                    <% item.pills.forEach(function(pill) { %>
                      <span class="card-pill"><%= pill %></span>
                    <% }); %>
                  </div>
                <% } %>

                <% if (item.metrics && item.metrics.length > 0) { %>
                  <div class="card-metrics-row">
                    <% item.metrics.forEach(function(m) { %>
                      <div class="c-metric"><strong><%= m.val %></strong><span><%= m.lbl %></span></div>
                    <% }); %>
                  </div>
                <% } %>

                <% if (item.projects && item.projects.length > 0) { %>
                  <div class="card-proj-list">
                    <% item.projects.forEach(function(p) { %>
                      <div class="proj-item"><strong><%= p.icon %> <%= p.name %>:</strong> <%= p.detail %></div>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="/static/SVGLoader.js"></script>
  <script src="/static/main.js"></script>
</body>
</html>
