<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= club.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <canvas id="bg-canvas"></canvas>

  <!-- Title Screen Lockup -->
  <div id="lockup">
    <div class="txt" id="lockup-text">
      <h1 class="t1">Interact</h1>
      <p class="t2">Club of BDU STEM Center</p>
      <p class="t3"><%= club.location %></p>
    </div>
    <!-- 3D WebGL Rotary Wheel renders directly over this layout anchor -->
    <div class="mark" id="wheel-anchor"></div>
  </div>

  <!-- Nav Gear Tooltip (3D DOM overlay, appears on tooth hover) -->
  <div id="nav-tooltip" aria-hidden="true"></div>

  <!-- Main Content Area (appears post-tunnel) -->
  <div id="main-content" aria-label="Main Content Area">
    <div class="content-placeholder">
      <div class="content-placeholder-inner">
        <div class="cp-label">Select a section</div>
        <div class="cp-hint">Use the gear wheel to navigate</div>
      </div>
    </div>
  </div>

  <!-- 3D Spatial Beacon Stations Anchored to In-Tunnel Swarm Particles -->
  <div id="beacon-overlay" aria-label="3D Interactive Stations">
    <% if (typeof tunnelItems !== 'undefined' && tunnelItems.length > 0) { %>
      <% tunnelItems.forEach(function(item) { %>
        <div class="beacon-node <%= item.side || 'face-right' %>" id="<%= item.id %>" data-pidx="<%= item.pIdx %>">
          <% if (item.side === 'face-left') { %>
            <!-- Right wall particle pointing inward to the left -->
            <svg class="beacon-stem stem-left" width="55" height="25" viewBox="0 0 55 25">
              <polyline points="55,20 35,6 0,6" fill="none" stroke="rgba(29, 133, 215, 0.55)" stroke-width="1.4" stroke-dasharray="2 2" />
              <circle cx="0" cy="6" r="2.5" fill="#1d85d7" />
            </svg>
          <% } else if (item.side === 'face-down') { %>
            <!-- Top wall particle pointing inward downward -->
            <svg class="beacon-stem stem-down" width="25" height="45" viewBox="0 0 25 45">
              <polyline points="12,0 12,25 12,45" fill="none" stroke="rgba(29, 133, 215, 0.55)" stroke-width="1.4" stroke-dasharray="2 2" />
              <circle cx="12" cy="45" r="2.5" fill="#1d85d7" />
            </svg>
          <% } else if (item.side === 'face-up') { %>
            <!-- Bottom wall particle pointing inward upward -->
            <svg class="beacon-stem stem-up" width="25" height="45" viewBox="0 0 25 45">
              <polyline points="12,45 12,20 12,0" fill="none" stroke="rgba(29, 133, 215, 0.55)" stroke-width="1.4" stroke-dasharray="2 2" />
              <circle cx="12" cy="0" r="2.5" fill="#1d85d7" />
            </svg>
          <% } else { %>
            <!-- Left wall particle pointing inward to the right (default) -->
            <svg class="beacon-stem stem-right" width="55" height="25" viewBox="0 0 55 25">
              <polyline points="0,20 20,6 55,6" fill="none" stroke="rgba(29, 133, 215, 0.55)" stroke-width="1.4" stroke-dasharray="2 2" />
              <circle cx="55" cy="6" r="2.5" fill="#1d85d7" />
            </svg>
          <% } %>

          <div class="beacon-card">
            <div class="card-header">
              <span class="card-tag-badge"><%= item.badge || '✨ Story' %></span>
              <span class="card-tag-title"><%= item.title %></span>
              <button class="card-toggle-btn" aria-label="Toggle details">+</button>
            </div>
            <div class="card-drawer">
              <div class="card-body">
                <% if (item.kicker) { %>
                  <span class="card-kicker"><%= item.kicker %></span>
                <% } %>
                <h3 class="card-heading"><%= item.title %></h3>
                <% if (item.sub) { %>
                  <p class="card-sub"><%= item.sub %></p>
                <% } %>
                <% if (item.desc) { %>
                  <p class="card-desc"><%= item.desc %></p>
                <% } %>

                <% if (item.pills && item.pills.length > 0) { %>
                  <div class="card-pill-list">
                    <% item.pills.forEach(function(pill) { %>
                      <span class="card-pill"><%= pill %></span>
                    <% }); %>
                  </div>
                <% } %>

                <% if (item.metrics && item.metrics.length > 0) { %>
                  <div class="card-metrics-row">
                    <% item.metrics.forEach(function(m) { %>
                      <div class="c-metric"><strong><%= m.val %></strong><span><%= m.lbl %></span></div>
                    <% }); %>
                  </div>
                <% } %>

                <% if (item.projects && item.projects.length > 0) { %>
                  <div class="card-proj-list">
                    <% item.projects.forEach(function(p) { %>
                      <div class="proj-item"><strong><%= p.icon %> <%= p.name %>:</strong> <%= p.detail %></div>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="/static/main.js"></script>
</body>
</html>
